# PocketBase (local Compose default)
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# Public origin, no trailing slash. Used for canonical URLs, share-preview tags,
# robots.txt, and sitemap.xml. Set this to the real domain before deploying —
# link previews in WhatsApp and Instagram resolve the image against it.
VITE_SITE_URL=http://localhost:5173

# Share-preview image, served from public/. Supply a 1200x630 JPEG of your own
# work: without it, shared links show text with no photograph.
VITE_OG_IMAGE=/og-default.jpg

# Max upload size for Library (MB)
MAX_UPLOAD_MB=25
VITE_MAX_UPLOAD_MB=25

# Photographer Studio account created by `npm run seed`
SEED_EMAIL=photographer@example.com
SEED_PASSWORD=change-me-now

# PocketBase superuser used only by the seed script (not committed secrets)
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-admin

# Web Push (Studio PWA). Generate with `npx tsx scripts/vapid-keys.ts`.
# Public key is safe in the Vite client; private key is PocketBase-only.
# VITE_VAPID_PUBLIC_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Outbound mail (Resend SMTP). Local `docker compose` reads THIS file for RESEND_*.
# VPS uses deploy/.env. Domain must be verified in Resend.
# RESEND_API_KEY=
# SMTP_FROM=hello@ibrahimlens.com.ng
# SMTP_FROM_NAME=Ibrahim Lens

# Optional: force seed superuser path
# PB_SEED_VIA_DOCKER=1   # always use `docker compose exec`
# PB_SEED_VIA_DOCKER=0   # always use local PocketBase binary
# POCKETBASE_BIN=
# PB_DATA_DIR=./pb_data
# (Default: auto-detect running Compose `pocketbase` service)
