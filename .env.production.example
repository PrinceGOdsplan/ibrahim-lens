# Copy to .env.production before running `npm run build` for the live site.
# Both values are baked into the bundle at build time, so they must be the
# deployed origin — Caddy proxies /api and /_ to PocketBase on the same domain.
VITE_SITE_URL=https://ibrahimlens.com.ng
VITE_POCKETBASE_URL=https://ibrahimlens.com.ng

VITE_MAX_UPLOAD_MB=25
