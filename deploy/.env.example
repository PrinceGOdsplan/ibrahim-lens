# Domain Caddy requests a certificate for. Must already resolve to this server.
SITE_DOMAIN=ibrahimlens.com.ng
# Public origin used in outbound mail links (no trailing slash).
SITE_URL=https://ibrahimlens.com.ng

# Web Push VAPID (Studio home-screen notices). Generate with `npx tsx scripts/vapid-keys.ts`.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Extra gate in front of PocketBase Admin on the public host (Caddy basicauth).
# Generate a bcrypt hash: docker run --rm caddy:2-alpine caddy hash-password
# Leave unset to fail closed ( /_/ returns 401 ). Local PocketBase on :8090 skips this.
# ADMIN_BASIC_USER=operator
# ADMIN_BASIC_HASH=

# Studio Assistant (OpenRouter). PocketBase-only — never VITE_*.
# Without a key the corner chat still shows and says Assistant is not set up.
# OPENROUTER_API_KEY=
# ASSISTANT_MODEL_CHEAP=google/gemini-2.5-flash-lite
# ASSISTANT_MODEL_MID=google/gemini-2.5-flash
# ASSISTANT_CREDIT_WARN_USD=1

# Cloudflare Web Analytics for Studio Dashboard (visits + top pages).
# PocketBase-only — never VITE_*. Create a token with Account Analytics Read.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_RUM_SITE_TAG=

# Outbound mail (Resend SMTP). Domain ibrahimlens.com.ng must stay verified in Resend.
# Do not enable Resend inbound/receiving — Cloudflare Email Routing owns apex MX.
# Routing destination must be an external mailbox (Gmail/Outlook), not @ibrahimlens.com.ng.
# After DNS changes: npx tsx scripts/check-mail-dns.ts
# Restart PocketBase after setting RESEND_API_KEY so 01_smtp.pb.js can apply it.
# RESEND_API_KEY=
# SMTP_FROM=hello@ibrahimlens.com.ng
# SMTP_FROM_NAME=Ibrahim Lens
