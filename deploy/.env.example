# Domain Caddy requests a certificate for. Must already resolve to this server.
SITE_DOMAIN=ibrahimlens.com.ng
# Public origin used in outbound mail links (no trailing slash).
SITE_URL=https://ibrahimlens.com.ng

# Web Push VAPID (Studio home-screen notices). Generate with `npx tsx scripts/vapid-keys.ts`.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Extra gate in front of PocketBase Admin on the public host (Caddy basicauth).
# Generate a bcrypt hash: docker run --rm caddy:2-alpine caddy hash-password
# Leave unset to fail closed ( /_/ returns 401 ). Local PocketBase on :8090 skips this.
# ADMIN_BASIC_USER=operator
# ADMIN_BASIC_HASH=

# Outbound mail (Resend SMTP). Domain must be verified in Resend first.
# Do not enable Resend inbound/receiving — Cloudflare Email Routing owns MX.
# RESEND_API_KEY=
# SMTP_FROM=hello@ibrahimlens.com.ng
# SMTP_FROM_NAME=Ibrahim Lens
