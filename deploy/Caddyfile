{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Vite emits content-hashed filenames under /assets, so they can be cached
	# permanently. Only match files that exist — otherwise a miss would ship
	# Cache-Control: immutable on a 404 and poison CDN caches for a year.
	@assets {
		path /assets/*
		file {path}
	}
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		file_server
	}

	# Public photo files (originals + thumbs). Keep TTL short so Portfolio removals
	# stop serving from Cloudflare within about an hour. Delivery gallery copies are
	# deleted on revoke/expiry (those URLs 404 at origin once CF expires).
	@pbfiles path /api/files/*
	handle @pbfiles {
		header Cache-Control "public, max-age=3600"
		reverse_proxy pocketbase:8090
	}

	# PocketBase Admin — extra shared secret in front of the Admin password.
	# Empty ADMIN_BASIC_HASH means no valid user (fail closed). Local Compose
	# talks to PocketBase on :8090 and does not use this handle.
	@admin path /_/*
	handle @admin {
		header Cache-Control "private, no-store"
		basicauth {
			{$ADMIN_BASIC_USER} {$ADMIN_BASIC_HASH}
		}
		reverse_proxy pocketbase:8090
	}

	# Assistant turns can wait on OpenRouter (~60s). Must sit before /api/*.
	@assistant path /api/ibrahim/assistant*
	handle @assistant {
		header Cache-Control "private, no-store"
		reverse_proxy pocketbase:8090 {
			transport http {
				response_header_timeout 70s
				read_timeout 70s
				write_timeout 70s
			}
		}
	}

	# PocketBase REST — never cache.
	@pocketbase path /api/*
	handle @pocketbase {
		header Cache-Control "private, no-store"
		reverse_proxy pocketbase:8090 {
			flush_interval -1
		}
	}

	# Studio service worker — never cache; scope is /studio/ by path.
	@sw path /studio/sw.js
	handle @sw {
		header Cache-Control "private, no-store"
		header Service-Worker-Allowed "/studio/"
		root * /srv
		file_server
	}

	# Delivery share unfurlers need OG tags in the first HTML response (SPA JS is ignored).
	@deliveryShare {
		path_regexp deliveryToken ^/g/([A-Za-z0-9_-]+)/?$
		header_regexp User-Agent (?i)(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|WhatsApp|Applebot|iMessage|Pinterest|redditbot|SkypeUriPreview|Googlebot)
	}
	handle @deliveryShare {
		rewrite * /api/ibrahim/delivery-og/{re.deliveryToken.1}
		reverse_proxy pocketbase:8090
	}

	# Known SPA routes get the shell. Static files that exist on disk
	# (og-default.jpg, robots.txt, sitemap, favicon, studio icons) still serve.
	# Everything else is a real 404 — not index.html with HTTP 200.
	@spa path_regexp spa ^/(|about|portfolio|work(/[A-Za-z0-9_-]+)?|contact|privacy|terms|studio(/.*)?|g/[A-Za-z0-9_-]+)/?$
	handle @spa {
		root * /srv
		header Cache-Control "no-cache"
		header X-Frame-Options SAMEORIGIN
		# script-src allows Cloudflare Web Analytics beacon (auto-injected at the edge).
	# connect-src 'self' covers automatic setup posting to /cdn-cgi/rum.
	header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' https://static.cloudflareinsights.com; frame-ancestors 'self'"
		rewrite * /index.html
		file_server
	}

	handle {
		root * /srv
		header Cache-Control "no-cache"
		@hasFile file {path}
		handle @hasFile {
			header X-Frame-Options SAMEORIGIN
			file_server
		}
		handle {
			header Content-Type "text/html; charset=utf-8"
			respond <<HTML
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Not found · Ibrahim Lens</title>
<style>
body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#100e0b;color:#f3ebe0;font-family:system-ui,sans-serif}
a{color:#c9922e}
main{padding:2rem;text-align:center;max-width:28rem}
h1{font-size:1.75rem;font-weight:600;margin:0}
p{margin:1rem 0 0;opacity:.75}
</style>
</head>
<body><main><h1>Page not found</h1><p>That path does not exist on this site.</p><p><a href="/">Back to Home</a></p></main></body>
</html>
HTML 404
		}
	}
}

# Uncomment once the www record exists in DNS.
# www.{$SITE_DOMAIN} {
# 	redir https://{$SITE_DOMAIN}{uri} permanent
# }
